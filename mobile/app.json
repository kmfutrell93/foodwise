{
  "expo": {
    "name": "FoodWise: GLP-1 Meal Planner",
    "slug": "foodwise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/nori_icon.png",
    "scheme": "foodwise",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.foodwise.ios",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#141311",
        "foregroundImage": "./assets/images/nori_icon.png"
      },
      "package": "app.foodwise.android",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/nori_icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/nori_icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#141311",
          "dark": {
            "backgroundColor": "#141311"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/nori_icon.png",
          "color": "#E89D35"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "91fe0568-97cd-410a-953c-b0f80ca64414"
      }
    },
    "owner": "kmfutrell93",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/91fe0568-97cd-410a-953c-b0f80ca64414"
    }
  }
}
